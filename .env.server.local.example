SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=your-staging-publishable-key
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Only needed after a real gateway and signed event source are deployed.
# Keep both values server-side and out of the frontend.
# SUPABASE_SERVICE_ROLE_KEY=
# GATEWAY_WEBHOOK_SECRET=

# Local WSL laboratory only. These flags are rejected in production.
# Persistent sessions and per-device peer metadata require the service-role
# key above and migration 202611241245; never put the key in frontend env.
# DATAPLUS_WG_LAB_ENABLED=1
# DATAPLUS_WG_SESSION_PERSISTENCE=1
# DATAPLUS_WG_DEVICES_ENABLED=1
